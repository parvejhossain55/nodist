{
  "name": "nodist",
  "version": "1.0.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "description": "A nodejs modular based backend project template",
  "keywords": [
    "nodejs",
    "backend-template"
  ],
  "homepage": "https://github.com/parvejhossain55/nodist#readme",
  "bugs": {
    "url": "https://github.com/parvejhossain55/nodist/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/parvejhossain55/nodist.git"
  },
  "license": "MIT",
  "author": "Parvej Hossain",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && tsc-alias",
    "start": "node dist/server.js",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin": "link:@typescript/eslint/eslint-plugin",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.4.3"
  }
}
