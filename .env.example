NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Database
MONGO_URI=mongodb://localhost:27017/nodist

# Redis
REDIS_URL=redis://localhost:6379

# Frontend Url
FRONTEND_URL=http://localhost:3000

# Auth - generate strong random secrets, e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET=replace-with-a-random-32+char-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-32+char-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=*

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Logging
LOG_LEVEL=info

# Email (SMTP)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your-mailtrap-user
SMTP_PASSWORD=your-mailtrap-password
SMTP_FROM=noreply@nodist.dev

# Web Push (VAPID) - generate keys with `pnpm generate:vapid`
VAPID_SUBJECT=mailto:noreply@nodist.dev
VAPID_PUBLIC_KEY=replace-with-your-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-your-vapid-private-key